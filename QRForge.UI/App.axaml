<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="QRForge.UI.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

     <Application.Styles>
         <FluentTheme />
     </Application.Styles>
             
     <Application.Resources>
         <!-- Industrial Theme Colors -->
         <SolidColorBrush x:Key="SteelBlueBrush" Color="#4682B4"/>
         <SolidColorBrush x:Key="DarkSteelBrush" Color="#2B4C6F"/>
         <SolidColorBrush x:Key="BurntOrangeBrush" Color="#CC5500"/>
         <SolidColorBrush x:Key="LightOrangeBrush" Color="#FF7A22"/>
         <SolidColorBrush x:Key="IndustrialGray" Color="#2A2A2A"/>
         <SolidColorBrush x:Key="IndustrialSilver" Color="#C0C0C0"/>
         <LinearGradientBrush x:Key="ForgeBackgroundBrush"
                              StartPoint="0%,0%"
                              EndPoint="100%,100%">
             <GradientStop Offset="0.0" Color="#2b4c6f"/>
             <GradientStop Offset="1.0" Color="#151515"/>
         </LinearGradientBrush>
     </Application.Resources>
</Application>